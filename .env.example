# LOCAL DATABASE SETUP
# local url with standard port if using a different port then update `27017`
MONGODB_URI='mongodb://localhost:27017/'
DB_NAME='noladevs'

# Let Me In
PUBLIC_DINGDONG_HOST='https://...'
PUBLIC_DINGDONG_PHRASE='<json object>'

# noladevs eventbot
SLACK_BOT_TOKEN='xoxb-...'

# GitHub OAuth (create an OAuth App at https://github.com/settings/developers,
# callback URL: http://localhost:5173/login/github/callback for local dev)
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''

# Optional: GitHub user ID (numeric) of the bootstrap super admin.
# When this user signs in, they are promoted to role=super.
# Find your numeric id at https://api.github.com/users/<your-login>
BOOTSTRAP_SUPER_GITHUB_ID=''